{
  "extends": "./node_modules/@fingerprintjs/tsconfig-dx-team/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "bundler",
    "customConditions": ["fastly"],
    "esModuleInterop": true,
    "lib": [ "es2022" ],
    "types": [ "node", "jest" ],
    "rootDir": ".",
    "outDir": "./build",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./build.ts",
    "./src/**/*.ts",
    "./scripts/**/*.ts",
    "./test/**/*.ts",
  ],
  "exclude": ["node_modules"]
}

{
  "extends": "./node_modules/@fingerprintjs/tsconfig-dx-team/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "target": "es2020",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "lib": [ "es2022" ],
    "types": [ "node", "jest" ],
    "rootDir": ".",
    "outDir": "./build",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "./build.ts",
    "./src/**/*.ts",
    "./scripts/**/*.ts",
    "./test/**/*.ts",
  ],
  "exclude": ["node_modules"],
  "ts-node": {
    "experimentalSpecifierResolution": "node",
    "compilerOptions": {
      "module": "CommonJS"
    },
  }
}

{
  "name": "fastly-compute-proxy",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@changesets/cli": "^2.31.0",
    "@fastly/cli": "^15.4.0",
    "@fingerprintjs/changesets-changelog-format": "^0.2.0",
    "@fingerprintjs/commit-lint-dx-team": "^0.1.0",
    "@fingerprintjs/conventional-changelog-dx-team": "^0.2.0",
    "@fingerprintjs/eslint-config-dx-team": "^3.0.0",
    "@fingerprintjs/prettier-config-dx-team": "^0.3.0",
    "@fingerprintjs/tsconfig-dx-team": "^0.0.2",
    "@jest/globals": "^30.4.1",
    "@types/cookie": "^0.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "babel-jest": "^30.4.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "fastly": "^15.1.0",
    "globals": "^15.15.0",
    "husky": "^9.1.5",
    "jest": "^30.4.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@fastly/js-compute": "^3.43.1",
    "cookie": "0.7.0"
  },
  "scripts": {
    "assemble": "js-compute-runtime --enable-http-cache build/index.js bin/main.wasm",
    "pack": "fastly compute pack --wasm-binary=./bin/main.wasm",
    "build": "node build.ts && fastly compute metadata --enable && pnpm run assemble && pnpm run pack",
    "artifact:create": "fastly compute build",
    "deploy": "fastly compute publish",
    "dev": "fastly compute serve",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky",
    "lint": "eslint --max-warnings 0 src/",
    "lint:fix": "pnpm lint --fix",
    "ci": "node scripts/ci.ts",
    "test:mock-e2e": "node scripts/mockTests.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:dts": "echo \"No type tests introduced\" && exit 0"
  },
  "lint-staged": {
    "src/**/*.ts": "pnpm lint:fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}

{
  "name": "fastly-compute-proxy",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@changesets/cli": "^2.31.0",
    "@fastly/cli": "^15.4.0",
    "@fingerprintjs/changesets-changelog-format": "^0.2.0",
    "@fingerprintjs/commit-lint-dx-team": "^0.1.0",
    "@fingerprintjs/conventional-changelog-dx-team": "^0.2.0",
    "@fingerprintjs/eslint-config-dx-team": "^3.0.0",
    "@fingerprintjs/prettier-config-dx-team": "^0.3.0",
    "@fingerprintjs/tsconfig-dx-team": "^0.0.2",
    "@jest/globals": "^30.4.1",
    "@types/cookie": "^0.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.9",
    "babel-jest": "^30.4.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "fastly": "^15.1.0",
    "globals": "^15.15.0",
    "husky": "^9.1.5",
    "jest": "^30.4.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@fastly/js-compute": "^3.43.1",
    "cookie": "0.7.0"
  },
  "scripts": {
    "assemble": "js-compute-runtime build/index.js bin/main.wasm",
    "pack": "fastly compute pack --wasm-binary=./bin/main.wasm",
    "build": "ts-node build.ts && fastly compute metadata --enable && pnpm run assemble && pnpm run pack",
    "artifact:create": "fastly compute build",
    "deploy": "fastly compute publish",
    "dev": "fastly compute serve",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky",
    "lint": "eslint --max-warnings 0 src/",
    "lint:fix": "pnpm lint --fix",
    "ci": "ts-node --transpile-only scripts/ci.ts",
    "test:mock-e2e": "ts-node scripts/mockTests.ts",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --coverage --config jest.config.js",
    "test:dts": "echo \"No type tests introduced\" && exit 0"
  },
  "lint-staged": {
    "src/**/*.ts": "pnpm lint:fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a"
}
